# --- Base de donnees ---
# SQLite en local (fichier). Pour un deploiement serverless (Vercel), voir le README :
# le systeme de fichiers y est ephemere, il faut alors pointer DATABASE_URL vers une
# base Postgres (Neon, Vercel Postgres, Supabase...) et changer le provider dans
# prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Envoi d'e-mails (Resend) ---
# Cle API a recuperer sur https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Adresse d'expedition, doit appartenir a un domaine verifie sur Resend
EMAIL_FROM="Le Petit Bistrot <contact@monrestaurant.fr>"

# --- Dashboard admin ---
# Mot de passe pour se connecter a /admin (a changer imperativement)
ADMIN_PASSWORD="change-moi"
# Chaine aleatoire longue utilisee pour signer le cookie de session admin
# (genere par ex. avec: openssl rand -hex 32)
ADMIN_SESSION_SECRET="change-moi-aussi-une-longue-chaine-aleatoire"

# --- Identite du commerce (visible cote client) ---
NEXT_PUBLIC_BUSINESS_NAME="Le Petit Bistrot"
NEXT_PUBLIC_LOGO_URL=""
# Lien vers votre fiche d'avis Google, propose APRES le tour de roue,
# independamment du lot gagne (jamais une condition). Laisser vide pour
# desactiver cet ecran.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""
